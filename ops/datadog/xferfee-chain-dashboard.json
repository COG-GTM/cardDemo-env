{
  "title": "CardDemo XFRDAILY transfer-fee chain",
  "description": "SYSOUT counters and return codes of XFRDAILY (CBXFR01C -> XFERFEE -> CBXFR03C) from the Java port's Micrometer meters (COG-1241).",
  "layout_type": "ordered",
  "template_variables": [
    {
      "name": "env",
      "prefix": "env",
      "available_values": [],
      "default": "*"
    }
  ],
  "widgets": [
    {
      "definition": {
        "type": "group",
        "title": "Return codes (JES MAXCC / COND CODE)",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "type": "query_value",
              "title": "XFRDAILY MAXCC",
              "autoscale": true,
              "precision": 0,
              "requests": [
                {
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q",
                      "query": "max:carddemo.xferfee.run.maxcc{$env}",
                      "aggregator": "last"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q"
                    }
                  ],
                  "conditional_formats": [
                    {
                      "comparator": ">=",
                      "value": 8,
                      "palette": "white_on_red"
                    },
                    {
                      "comparator": ">=",
                      "value": 4,
                      "palette": "white_on_yellow"
                    },
                    {
                      "comparator": "<",
                      "value": 4,
                      "palette": "white_on_green"
                    }
                  ],
                  "response_format": "scalar"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "query_value",
              "title": "STEP010 CBXFR01C RC",
              "autoscale": true,
              "precision": 0,
              "requests": [
                {
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q",
                      "query": "max:carddemo.xferfee.step.return.code{$env,step:step010}",
                      "aggregator": "last"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q"
                    }
                  ],
                  "conditional_formats": [
                    {
                      "comparator": ">=",
                      "value": 8,
                      "palette": "white_on_red"
                    },
                    {
                      "comparator": ">=",
                      "value": 4,
                      "palette": "white_on_yellow"
                    },
                    {
                      "comparator": "<",
                      "value": 4,
                      "palette": "white_on_green"
                    }
                  ],
                  "response_format": "scalar"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "query_value",
              "title": "STEP020 XFERFEE RC",
              "autoscale": true,
              "precision": 0,
              "requests": [
                {
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q",
                      "query": "max:carddemo.xferfee.step.return.code{$env,step:step020}",
                      "aggregator": "last"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q"
                    }
                  ],
                  "conditional_formats": [
                    {
                      "comparator": ">=",
                      "value": 8,
                      "palette": "white_on_red"
                    },
                    {
                      "comparator": ">=",
                      "value": 4,
                      "palette": "white_on_yellow"
                    },
                    {
                      "comparator": "<",
                      "value": 4,
                      "palette": "white_on_green"
                    }
                  ],
                  "response_format": "scalar"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "query_value",
              "title": "STEP030 CBXFR03C RC",
              "autoscale": true,
              "precision": 0,
              "requests": [
                {
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q",
                      "query": "max:carddemo.xferfee.step.return.code{$env,step:step030}",
                      "aggregator": "last"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q"
                    }
                  ],
                  "conditional_formats": [
                    {
                      "comparator": ">=",
                      "value": 8,
                      "palette": "white_on_red"
                    },
                    {
                      "comparator": ">=",
                      "value": 4,
                      "palette": "white_on_yellow"
                    },
                    {
                      "comparator": "<",
                      "value": 4,
                      "palette": "white_on_green"
                    }
                  ],
                  "response_format": "scalar"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "query_value",
              "title": "RC 4 warnings",
              "autoscale": true,
              "precision": 0,
              "requests": [
                {
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q",
                      "query": "sum:carddemo.xferfee.step.warnings{$env}.as_count()",
                      "aggregator": "sum"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q"
                    }
                  ],
                  "conditional_formats": [
                    {
                      "comparator": ">",
                      "value": 0,
                      "palette": "white_on_yellow"
                    },
                    {
                      "comparator": "<=",
                      "value": 0,
                      "palette": "white_on_green"
                    }
                  ],
                  "response_format": "scalar"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "query_value",
              "title": "RC 8 alerts / DLQ entries",
              "autoscale": true,
              "precision": 0,
              "requests": [
                {
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q",
                      "query": "sum:carddemo.xferfee.dlq.entries{$env}.as_count()",
                      "aggregator": "sum"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q"
                    }
                  ],
                  "conditional_formats": [
                    {
                      "comparator": ">",
                      "value": 0,
                      "palette": "white_on_red"
                    },
                    {
                      "comparator": "<=",
                      "value": 0,
                      "palette": "white_on_green"
                    }
                  ],
                  "response_format": "scalar"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "definition": {
        "type": "group",
        "title": "CBXFR01C extract (STEP010 SYSOUT)",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "type": "query_value",
              "title": "RECORDS READ",
              "autoscale": true,
              "precision": 0,
              "requests": [
                {
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q",
                      "query": "sum:carddemo.xferfee.extract.records.read{$env}.as_count()",
                      "aggregator": "sum"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q"
                    }
                  ],
                  "conditional_formats": [],
                  "response_format": "scalar"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "query_value",
              "title": "TRANSFERS SELECTED",
              "autoscale": true,
              "precision": 0,
              "requests": [
                {
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q",
                      "query": "sum:carddemo.xferfee.extract.transfers.selected{$env}.as_count()",
                      "aggregator": "sum"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q"
                    }
                  ],
                  "conditional_formats": [],
                  "response_format": "scalar"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "query_value",
              "title": "UNMATCHED CARDS",
              "autoscale": true,
              "precision": 0,
              "requests": [
                {
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q",
                      "query": "sum:carddemo.xferfee.extract.unmatched.cards{$env}.as_count()",
                      "aggregator": "sum"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q"
                    }
                  ],
                  "conditional_formats": [
                    {
                      "comparator": ">",
                      "value": 0,
                      "palette": "white_on_yellow"
                    },
                    {
                      "comparator": "<=",
                      "value": 0,
                      "palette": "white_on_green"
                    }
                  ],
                  "response_format": "scalar"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "definition": {
        "type": "group",
        "title": "XFERFEE posting (STEP020) and CBXFR03C recon (STEP030)",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "type": "query_value",
              "title": "TRANSFERS POSTED",
              "autoscale": true,
              "precision": 0,
              "requests": [
                {
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q",
                      "query": "sum:carddemo.xferfee.posting.transfers.posted{$env}.as_count()",
                      "aggregator": "sum"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q"
                    }
                  ],
                  "conditional_formats": [],
                  "response_format": "scalar"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "query_value",
              "title": "TOTAL FEES",
              "autoscale": true,
              "precision": 2,
              "requests": [
                {
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q",
                      "query": "sum:carddemo.xferfee.posting.fees.total{$env}.as_count()",
                      "aggregator": "sum"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q"
                    }
                  ],
                  "conditional_formats": [],
                  "response_format": "scalar"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "query_value",
              "title": "GRAND TOTAL FEE",
              "autoscale": true,
              "precision": 2,
              "requests": [
                {
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q",
                      "query": "sum:carddemo.xferfee.recon.grand.total.fee{$env}.as_count()",
                      "aggregator": "sum"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q"
                    }
                  ],
                  "conditional_formats": [],
                  "response_format": "scalar"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Posted fees vs reconciled grand total (should overlap)",
              "show_legend": true,
              "requests": [
                {
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "fees",
                      "query": "sum:carddemo.xferfee.posting.fees.total{$env}.as_count()"
                    },
                    {
                      "data_source": "metrics",
                      "name": "grand",
                      "query": "sum:carddemo.xferfee.recon.grand.total.fee{$env}.as_count()"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "fees",
                      "alias": "XFERFEE TOTAL FEES"
                    },
                    {
                      "formula": "grand",
                      "alias": "CBXFR03C GRAND TOTAL FEE"
                    }
                  ],
                  "response_format": "timeseries",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Selected vs posted transfers",
              "show_legend": true,
              "requests": [
                {
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "sel",
                      "query": "sum:carddemo.xferfee.extract.transfers.selected{$env}.as_count()"
                    },
                    {
                      "data_source": "metrics",
                      "name": "post",
                      "query": "sum:carddemo.xferfee.posting.transfers.posted{$env}.as_count()"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "sel",
                      "alias": "selected"
                    },
                    {
                      "formula": "post",
                      "alias": "posted"
                    }
                  ],
                  "response_format": "timeseries",
                  "display_type": "bars"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "definition": {
        "type": "group",
        "title": "Rejects and alerts",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "type": "timeseries",
              "title": "TransferRejected by reason",
              "show_legend": true,
              "requests": [
                {
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "rej",
                      "query": "sum:carddemo.xferfee.transfers.rejected{$env} by {step,reason}.as_count()"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "rej",
                      "alias": "rejected"
                    }
                  ],
                  "response_format": "timeseries",
                  "display_type": "bars"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Step runs by return code",
              "show_legend": true,
              "requests": [
                {
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "runs",
                      "query": "sum:carddemo.xferfee.step.runs{$env} by {step,rc}.as_count()"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "runs",
                      "alias": "runs"
                    }
                  ],
                  "response_format": "timeseries",
                  "display_type": "bars"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "manage_status",
              "title": "XFRDAILY monitors",
              "query": "tag:(chain:xferfee)",
              "summary_type": "monitors",
              "display_format": "countsAndList",
              "sort": "status,asc",
              "color_preference": "text",
              "hide_zero_counts": true,
              "show_last_triggered": true
            }
          }
        ]
      }
    }
  ],
  "notify_list": [],
  "reflow_type": "auto"
}
