//XFRRBACK JOB 'XFER CUT-OVER ROLLBACK',CLASS=A,MSGCLASS=0,
// NOTIFY=&SYSUID
//******************************************************************
//* XFRRBACK - ROLL THE ACCOUNT MASTER BACK TO THE LATEST
//*            ACCTDATA.XFER GENERATION (LEGACY-ADAPTER EGRESS).
//*            RUN ONLY UNDER docs/cutover/ROLLBACK.md, AFTER THE
//*            LEDGER RECONCILIATION SHOWS ZERO BREAKS.
//*            ACCTDATA.PS MUST BE BACKED UP BEFORE THIS STEP.
//******************************************************************
//STEP010  EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//ACCTIN   DD DSN=AWS.M2.CARDDEMO.ACCTDATA.XFER(0),DISP=SHR
//ACCTOUT  DD DSN=AWS.M2.CARDDEMO.ACCTDATA.PS,DISP=OLD
//SYSIN    DD *
  REPRO INFILE(ACCTIN) OUTFILE(ACCTOUT)
/*
