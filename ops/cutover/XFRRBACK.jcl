//XFRRBACK JOB 'XFERFEE ROLLBACK RESTORE',CLASS=A,MSGCLASS=0,
// NOTIFY=&SYSUID
//******************************************************************
//* COG-1252 ROLLBACK: RESTORE THE ACCOUNT MASTER FROM THE LAST
//* ACCTDATA.XFER GENERATION CATALOGUED BY THE JAVA LEGACY-ADAPTER
//* SO THAT XFRDAILY CAN BE RE-ENABLED ON THE NEXT BUSINESS DAY.
//* RUN ONLY AFTER ops/cutover/ledger_recon.sql REPORTS ALL CHECKS OK.
//******************************************************************
//STEP010  EXEC PGM=IDCAMS
