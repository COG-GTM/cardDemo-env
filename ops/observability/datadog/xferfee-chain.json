    },
    {
      "definition": {
        "type": "query_value",
        "title": "XFERFEE: TOTAL FEES",
        "precision": 2,
        "requests": [
          {
            "queries": [
              {
                "data_source": "metrics",
                "name": "q",
                "aggregator": "sum",
                "query": "sum:xfer.posting.fees.amount{chain:xferfee,$env}.as_count()"
              }
            ],
            "formulas": [
              {
                "formula": "q"
              }
            ],
            "response_format": "scalar"
          }
        ]
      }
    },
    {
      "definition": {
        "type": "query_value",
        "title": "CBXFR03C: GRAND TOTAL FEE",
        "precision": 2,
        "requests": [
          {
            "queries": [
              {
                "data_source": "metrics",
                "name": "q",
                "aggregator": "sum",
                "query": "sum:xfer.recon.fees.grand_total{chain:xferfee,$env}.as_count()"
              }
            ],
            "formulas": [
              {
                "formula": "q"
              }
            ],
            "response_format": "scalar"
          }
        ]
      }
    },
    {
      "definition": {
        "type": "query_table",
        "title": "Last return code by step",
        "requests": [
          {
            "queries": [
              {
                "data_source": "metrics",
                "name": "rc",
                "aggregator": "last",
                "query": "max:xfer.step.return_code{chain:xferfee,$env} by {step,program}"
              }
            ],
            "formulas": [
              {
                "formula": "rc",
                "conditional_formats": [
                  {
                    "comparator": ">=",
                    "value": 8,
                    "palette": "white_on_red"
                  },
                  {
                    "comparator": ">=",
                    "value": 4,
                    "palette": "white_on_yellow"
                  },
                  {
                    "comparator": "<",
                    "value": 4,
                    "palette": "white_on_green"
                  }
                ]
              }
            ],
            "response_format": "scalar"
          }
        ]
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Step runs by outcome",
        "requests": [
          {
            "queries": [
              {
                "data_source": "metrics",
                "name": "q",
                "query": "sum:xfer.step.runs{chain:xferfee,$env} by {step,outcome}.as_count()"
              }
            ],
            "formulas": [
              {
                "formula": "q"
              }
            ],
            "response_format": "timeseries",
            "display_type": "bars"
          }
        ]
      }
    },
    {
