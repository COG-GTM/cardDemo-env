{
  "title": "XFERFEE chain: COBOL counters and return codes",
  "description": "Legacy CBXFR01C / XFERFEE / CBXFR03C SYSOUT counters and step return codes. Source: ops/observability/counter-catalog.json",
  "layout_type": "ordered",
  "template_variables": [
    {
      "name": "env",
      "prefix": "env",
      "available_values": [],
      "default": "*"
    }
  ],
  "widgets": [
    {
      "definition": {
        "type": "query_value",
        "title": "CBXFR01C: RECORDS READ",
        "precision": 0,
        "requests": [
          {
            "queries": [
              {
                "data_source": "metrics",
                "name": "q",
                "aggregator": "sum",
                "query": "sum:xfer.extract.records.read{chain:xferfee,$env}.as_count()"
              }
            ],
            "formulas": [
              {
                "formula": "q"
              }
            ],
            "response_format": "scalar"
          }
        ]
      }
    },
    {
      "definition": {
        "type": "query_value",
        "title": "CBXFR01C: TRANSFERS SELECTED",
