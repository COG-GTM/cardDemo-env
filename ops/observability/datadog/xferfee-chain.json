              {
                "formula": "q"
              }
            ],
            "response_format": "scalar"
          }
        ]
      }
    },
    {
      "definition": {
        "type": "query_value",
        "title": "XFERFEE: TRANSFERS POSTED",
        "precision": 0,
        "requests": [
          {
            "queries": [
              {
                "data_source": "metrics",
                "name": "q",
                "aggregator": "sum",
                "query": "sum:xfer.posting.transfers.posted{chain:xferfee,$env}.as_count()"
              }
            ],
            "formulas": [
              {
                "formula": "q"
              }
            ],
