        DFHMDF ATTRB=(ASKIP,BRT),                                      X
               COLOR=TURQUOISE,                                        X
               LENGTH=25,                                              X
               POS=(20,15),                                            X
               INITIAL='Please select an option :'
OPTION  DFHMDF ATTRB=(FSET,IC,NORM,NUM,UNPROT),                        X
               HILIGHT=UNDERLINE,                                      X
               LENGTH=2,                                               X
               POS=(20,41)
        DFHMDF ATTRB=(ASKIP,NORM),                                     X
               COLOR=GREEN,                                            X
               LENGTH=1,                                               X
               POS=(20,44)
ERRMSG  DFHMDF ATTRB=(ASKIP,BRT,FSET),                                 X
               COLOR=RED,                                              X
               LENGTH=78,                                              X
               POS=(23,1)
        DFHMDF ATTRB=(ASKIP,NORM),                                     X
               COLOR=YELLOW,                                           X
               LENGTH=23,                                              X
               POS=(24,1),                                             X
               INITIAL='ENTER=Continue  F3=Exit'
        DFHMSD TYPE=FINAL
        END
