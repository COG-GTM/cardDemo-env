               POS=(15,20),                                            X
               INITIAL=' '
OPTN011 DFHMDF ATTRB=(ASKIP,FSET,NORM),                                X
               COLOR=BLUE,                                             X
               LENGTH=40,                                              X
               POS=(16,20),                                            X
               INITIAL=' '
