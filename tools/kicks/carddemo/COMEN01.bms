COMEN01 DFHMSD CTRL=(ALARM,FREEKB),                                    X
               EXTATT=YES,                                             X
               LANG=COBOL,                                             X
               MODE=INOUT,                                             X
               STORAGE=AUTO,                                           X
               TIOAPFX=YES,                                            X
               TYPE=&SYSPARM
COMEN1A DFHMDI COLUMN=1,                                               X
               LINE=1,                                                 X
               SIZE=(24,80)
        DFHMDF ATTRB=(ASKIP,NORM),                                     X
               COLOR=BLUE,                                             X
               LENGTH=5,                                               X
               POS=(1,1),                                              X
               INITIAL='Tran:'
TRNNAME DFHMDF ATTRB=(ASKIP,FSET,NORM),                                X
               COLOR=BLUE,                                             X
               LENGTH=4,                                               X
               POS=(1,7)
TITLE01 DFHMDF ATTRB=(ASKIP,FSET,NORM),                                X
               COLOR=YELLOW,                                           X
               LENGTH=40,                                              X
               POS=(1,21)
        DFHMDF ATTRB=(ASKIP,NORM),                                     X
               COLOR=BLUE,                                             X
               LENGTH=5,                                               X
               POS=(1,65),                                             X
               INITIAL='Date:'
CURDATE DFHMDF ATTRB=(ASKIP,FSET,NORM),                                X
               COLOR=BLUE,                                             X
               LENGTH=8,                                               X
               POS=(1,71),                                             X
               INITIAL='mm/dd/yy'
        DFHMDF ATTRB=(ASKIP,NORM),                                     X
               COLOR=BLUE,                                             X
               LENGTH=5,                                               X
               POS=(2,1),                                              X
               INITIAL='Prog:'
PGMNAME DFHMDF ATTRB=(ASKIP,FSET,NORM),                                X
               COLOR=BLUE,                                             X
               LENGTH=8,                                               X
               POS=(2,7)
TITLE02 DFHMDF ATTRB=(ASKIP,FSET,NORM),                                X
               COLOR=YELLOW,                                           X
               LENGTH=40,                                              X
               POS=(2,21)
        DFHMDF ATTRB=(ASKIP,NORM),                                     X
               COLOR=BLUE,                                             X
               LENGTH=5,                                               X
               POS=(2,65),                                             X
               INITIAL='Time:'
CURTIME DFHMDF ATTRB=(ASKIP,FSET,NORM),                                X
               COLOR=BLUE,                                             X
               LENGTH=8,                                               X
               POS=(2,71),                                             X
               INITIAL='hh:mm:ss'
        DFHMDF ATTRB=(ASKIP,BRT),                                      X
               COLOR=NEUTRAL,                                          X
               LENGTH=9,                                               X
               POS=(4,35),                                             X
               INITIAL='Main Menu'
