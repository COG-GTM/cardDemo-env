//XFERFEE JOB 'TRANSFER FEE POSTING',CLASS=A,MSGCLASS=0,
// NOTIFY=&SYSUID
//******************************************************************
//* APPLY TABLE-DRIVEN FEES AND WRITE THE UPDATED ACCOUNT MASTER
//******************************************************************
//STEP020  EXEC PGM=XFERFEE
//STEPLIB  DD DSN=AWS.M2.CARDDEMO.LOADLIB,DISP=SHR
//XFEREXTR DD DSN=AWS.M2.CARDDEMO.XFER.EXTRACT(0),DISP=SHR
//ACCTFILE DD DSN=AWS.M2.CARDDEMO.ACCTDATA.PS,DISP=SHR
//ACCTOUT  DD DSN=AWS.M2.CARDDEMO.ACCTDATA.XFER(+1),
//            DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//            SPACE=(TRK,(1,1)),DCB=(RECFM=FB,LRECL=300,BLKSIZE=3000)
//XFERFEE  DD DSN=AWS.M2.CARDDEMO.XFER.FEES(+1),
//            DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//            SPACE=(TRK,(1,1)),DCB=(RECFM=FB,LRECL=100,BLKSIZE=1000)
//DB2PARM  DD *
DSN=CARDDEMO PLAN=XFERFEE
/*
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
