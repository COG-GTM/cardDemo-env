<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.carddemo.xferfee</groupId>
        <artifactId>xferfee-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>parity-replay</artifactId>
    <description>Replays one fixture case through whichever stage beans exist and writes JSON-lines outputs.</description>

    <dependencies>
        <dependency>
            <groupId>com.carddemo.xferfee</groupId>
            <artifactId>contracts</artifactId>
        </dependency>
        <dependency>
            <groupId>com.carddemo.xferfee</groupId>
            <artifactId>fee-policy</artifactId>
        </dependency>
        <dependency>
            <groupId>com.carddemo.xferfee</groupId>
            <artifactId>fee-schedule-service</artifactId>
        </dependency>
        <dependency>
            <groupId>com.carddemo.xferfee</groupId>
            <artifactId>transfer-intake-service</artifactId>
        </dependency>
        <dependency>
            <groupId>com.carddemo.xferfee</groupId>
            <artifactId>account-posting-service</artifactId>
        </dependency>
        <dependency>
            <groupId>com.carddemo.xferfee</groupId>
            <artifactId>reconciliation-service</artifactId>
        </dependency>
        <dependency>
            <groupId>com.carddemo.xferfee</groupId>
            <artifactId>legacy-adapter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>parity-replay</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
